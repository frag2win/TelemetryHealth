{
    "swagger": "2.0",
    "info": {
        "description": "REST API for TelemetryHealth control plane",
        "title": "TelemetryHealth API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/tenant/{tenant_id}/health": {
            "get": {
                "description": "Returns the composite health score, signal metrics, and auto-generated OTel remediation for a given tenant.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get Health Metrics for a Tenant",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant UUID",
                        "name": "tenant_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.HealthResponse"
                        }
                    },
                    "400": {
                        "description": "invalid path",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "rest.HealthResponse": {
            "type": "object",
            "properties": {
                "healthScore": {
                    "type": "number"
                },
                "metrics": {
                    "$ref": "#/definitions/rest.MetricsPayload"
                },
                "remediation": {
                    "$ref": "#/definitions/rest.RemediationPayload"
                }
            }
        },
        "rest.MetricValue": {
            "type": "object",
            "properties": {
                "change": {
                    "type": "number"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "rest.MetricsPayload": {
            "type": "object",
            "properties": {
                "cardinality": {
                    "$ref": "#/definitions/rest.MetricValue"
                },
                "coverage": {
                    "$ref": "#/definitions/rest.MetricValue"
                },
                "orphans": {
                    "$ref": "#/definitions/rest.MetricValue"
                }
            }
        },
        "rest.RemediationPayload": {
            "type": "object",
            "properties": {
                "issueType": {
                    "type": "string"
                },
                "yaml": {
                    "type": "string"
                }
            }
        }
    }
}