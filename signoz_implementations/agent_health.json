{
  "uuid": "telemetryhealth-agent-dashboard",
  "title": "TelemetryHealth: AI Agent Observability",
  "description": "Real-time AI Agent health index, token burn timelines, and trace error distributions.",
  "tags": [
    "telemetryhealth",
    "ai-agents"
  ],
  "variables": [
    {
      "name": "service_name",
      "textboxValue": "",
      "type": "query",
      "query": "label_values(telemetryhealth_agent_health_score, service_name)",
      "selectedValue": "all",
      "multi": true,
      "allValue": ".*"
    }
  ],
  "widgets": [
    {
      "id": "agent-health-gauge",
      "title": "AI Agent Health Score Gauge",
      "description": "Real-time composite health index score of the AI agent.",
      "type": "value",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "query": {
        "queryType": "promql",
        "promql": "avg(telemetryhealth_agent_health_score{service_name=~\"$service_name\"}) by (agent_id)",
        "legend": "{{agent_id}}"
      }
    },
    {
      "id": "token-burn-rate-timeline",
      "title": "AI Agent Token Burn Rate Timeline",
      "description": "Timeline of LLM token consumption speed (tokens/sec).",
      "type": "time_series",
      "layout": {
        "x": 4,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "query": {
        "queryType": "promql",
        "promql": "sum(rate(telemetryhealth_agent_token_burn_rate{service_name=~\"$service_name\"}[5m])) by (agent_id)",
        "legend": "{{agent_id}}"
      }
    },
    {
      "id": "trace-error-count-distribution",
      "title": "AI Agent Trace Error Count Distribution",
      "description": "Failure trends and aggregate error count per agent.",
      "type": "time_series",
      "layout": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 3
      },
      "query": {
        "queryType": "promql",
        "promql": "sum(increase(telemetryhealth_agent_trace_error_count{service_name=~\"$service_name\"}[5m])) by (agent_id)",
        "legend": "{{agent_id}}"
      }
    }
  ]
}
